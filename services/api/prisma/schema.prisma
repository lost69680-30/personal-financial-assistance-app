generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(uuid())
  email              String?               @unique
  phone              String                @unique
  passwordHash       String?
  firstName          String?
  lastName           String?
  preferredLanguage  String                @default("am")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  accounts           Account[]
  transactions       Transaction[]
  budgets            Budget[]
  savingsGoals       SavingsGoal[]
  assistanceRequests AssistanceRequest[]
  notifications      Notification[]

  @@map("users")
}

model Account {
  id                String        @id @default(uuid())
  userId            String
  name              String
  type              String
  provider          String?
  providerAccountId String?
  balance           Decimal       @default(0)
  currency          String        @default("ETB")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
  transactions      Transaction[]

  @@map("accounts")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  accountId String?
  title     String
  category  String
  amount    Decimal
  direction String
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  account   Account? @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  limit     Decimal
  spent     Decimal  @default(0)
  period    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("budgets")
}

model SavingsGoal {
  id        String   @id @default(uuid())
  userId    String
  title     String
  target    Decimal
  saved     Decimal  @default(0)
  deadline  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("savings_goals")
}

model AssistanceRequest {
  id        String   @id @default(uuid())
  userId    String
  title     String
  reason    String
  amount    Decimal?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("assistance_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}
